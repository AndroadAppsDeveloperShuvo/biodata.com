        }

        /* Pulse Ring */
        .pulse-ring {
            position: absolute;
            bottom: 0.25rem;
            right: 0.25rem;
            width: 1.5rem;
            height: 1.5rem;
        }
        .pulse-ring::before {
            content: '';
            position: absolute;
            left: -4px; top: -4px; right: -4px; bottom: -4px;
            border-radius: 50%;
            border: 2px solid #22c55e;
            animation: pulsate 2s ease-out infinite;
        }
        @keyframes pulsate {
            0% { transform: scale(0.5); opacity: 1; }
            100% { transform: scale(2); opacity: 0; }
