            33% { transform: translate(30px, -50px) scale(1.1); }
            66% { transform: translate(-20px, 20px) scale(0.9); }
            100% { transform: translate(0, 0) scale(1); }
        }

        /* ---------------- Premium Cards ---------------- */
        .premium-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            border-radius: 1.5rem;
            border: 1px solid rgba(255, 255, 255, 1);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            /* Entrance Animation Variables */
            opacity: 0;
            transform: translateY(40px) scale(0.95);
            animation: popIn 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
            transform-style: preserve-3d; /* For 3D elements inside */
            transition: box-shadow 0.3s ease;
        }
        .premium-card:hover {
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
        }

        @keyframes popIn {
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        .delay-1 { animation-delay: 0.1s; }
        .delay-2 { animation-delay: 0.2s; }
        .delay-3 { animation-delay: 0.3s; }
        .delay-4 { animation-delay: 0.4s; }
        .delay-5 { animation-delay: 0.5s; }

        /* 3D floating elements inside cards */
        .float-el { transform: translateZ(20px); }
        .float-el-high { transform: translateZ(40px); }

        /* ---------------- Avatar Morph Animation ---------------- */
        .avatar-morph {
            animation: morph 8s ease-in-out infinite;
            border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
            transition: all 1s ease-in-out;
        }
        .avatar-morph:hover {
            border-radius: 50%;
            box-shadow: 0 0 30px rgba(59, 130, 246, 0.4);
        }
        @keyframes morph {
            0% { border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; }
            50% { border-radius: 30% 60% 70% 40% / 50% 60% 30% 60%; }
            100% { border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; }
        }

        /* Text Gradient Animation */
        .animate-gradient-text {
            background: linear-gradient(to right, #2563eb, #7c3aed, #2563eb);
            background-size: 200% auto;
            color: transparent;
            -webkit-background-clip: text;
            animation: shine 3s linear infinite;
        }
        @keyframes shine {
